# Cleaned transaction log from the Data step (needs InvoiceDate, CustomerID,
# InvoiceNo, TotalPrice)
TRANSACTIONS_PATH=../data_pipeline/data/processed/clean_transactions.csv

# The SAME trained scaler/kmeans/segment-name mapping from the Model step —
# reused as-is (not retrained) so segment definitions stay consistent across
# every snapshot in time.
MODEL_DIR=../model_training/models

OUTPUT_DIR=./output

# How often to take a snapshot: 'ME' = month-end, 'W' = weekly (pandas offset alias)
SNAPSHOT_FREQUENCY=ME

# Minimum number of snapshots required to run (need at least 2 to see migration)
MIN_SNAPSHOTS=2
