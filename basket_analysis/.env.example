# Cleaned transaction log from the Data step (needs InvoiceNo, Description, Quantity)
TRANSACTIONS_PATH=../data_pipeline/data/processed/clean_transactions.csv

# Optional: the Model step's labeled customers, to run basket analysis
# within ONE segment only (e.g. "what do Champions buy together?").
# Leave blank to analyze all customers together.
CUSTOMERS_WITH_CLUSTERS_PATH=../model_training/models/customers_with_clusters.csv
SEGMENT_FILTER=

OUTPUT_DIR=./output

# Apriori thresholds — lower MIN_SUPPORT finds more (rarer) itemsets but is slower
MIN_SUPPORT=0.02
MIN_CONFIDENCE=0.3
MIN_LIFT=1.0

# Skip invoices with more than this many distinct items (housekeeping/noise)
MAX_BASKET_SIZE=50
