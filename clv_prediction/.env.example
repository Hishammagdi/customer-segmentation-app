# Cleaned transaction log from the Data step
TRANSACTIONS_PATH=../data_pipeline/data/processed/clean_transactions.csv

MODEL_OUTPUT_DIR=./models

# Fraction of the total date range used as the "calibration" period —
# features are built from this period, and the target (future spend) is
# the remaining "holdout" period. 0.7 means the first 70% of the customer
# history is used to predict spend in the last 30%.
CALIBRATION_FRACTION=0.7

RANDOM_STATE=42
